{
  "manifest_version": 3,
  "name": "Hassala — Arabic ↔ English Translator & Word Bank",
  "short_name": "Hassala",
  "version": "2.0.4",
  "description": "Translate Arabic ↔ English, save words to local folders, export anytime, and get interactive YouTube subtitles.",
  "minimum_chrome_version": "109",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Hassala — Translator & Word Bank",
    "default_icon": {
      "16": "src/icons/toolbar16.png",
      "32": "src/icons/toolbar32.png"
    }
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/fonts/BalooBhaijaan2-Variable.woff2",
        "src/fonts/Inter-Variable.woff2",
        "src/fonts/SpaceGrotesk-Variable.woff2",
        "src/fonts/Alexandria-Variable.woff2",
        "src/icons/mark.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/keyboard-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/site-policy.js",
        "src/wordbank.js",
        "src/content/floating.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/site-policy.js",
        "src/content/youtube.js"
      ],
      "css": [
        "src/content/youtube.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "homepage_url": "https://hassala.nagdista.com/"
}
